# OmniLLM public connection service (relay) on 139.224.110.2, behind Tengine
# (zz-relay.ixxzh.com.conf). Loopback only; systemd 219 (CentOS 7) options.
# It runs as its own no-login account that owns nothing: a compromised relay
# cannot rewrite the web client phones load, or anything else on the server.
[Unit]
Description=OmniLLM relay (relay.ixxzh.com)
After=network-online.target

[Service]
User=omnillm-relay
Group=omnillm-relay
ExecStart=/opt/omnillm/omnillm relay --listen 127.0.0.1:8470 --behind-tls-proxy --open --web-origin https://omni.ixxzh.com
Environment=LANG=en_US.UTF-8 HOME=/var/empty
WorkingDirectory=/
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryLimit=1G
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ReadOnlyDirectories=/
CapabilityBoundingSet=
# Network sockets and the journal only (systemd 219 knows this one).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
